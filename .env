GHANA_NLP_API_KEY=998a26606f0540d0ad648aaed9fe9ca2
GHANA_NLP_ASR_URL=https://translation-api.ghananlp.org/asr/v2/transcribe

# Whisper model size: tiny | base | small | medium (larger = more accurate, slower)
WHISPER_MODEL_SIZE=base

# Ollama model (must be pulled first: ollama pull llama3.2:3b)
OLLAMA_MODEL=qwen2.5:0.5b
OLLAMA_HOST=http://localhost:11434

# Audio settings
SAMPLE_RATE=16000
CHUNK_DURATION_SECONDS=5

# Language detection confidence threshold (0.0 - 1.0)
TWI_CONFIDENCE_THRESHOLD=0.6
